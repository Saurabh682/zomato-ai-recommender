# ==============================================================================
# LLM API Credentials
# ==============================================================================
# Groq API Key: Create at https://groq.com/ or https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google AI Studio API Key: Create at https://aistudio.google.com/ or https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Model Configurations
# ==============================================================================
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash

# Maximum candidate restaurants passed to LLM for ranking & explanation
MAX_CANDIDATES=400

# Backend Server Port
PORT=8000
